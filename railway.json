{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": [
      "dashboard/**",
      "engine/**",
      "railway.json",
      "requirements.txt"
    ]
  },
  "deploy": {
    "startCommand": "python3 dashboard/server.py",
    "healthcheckPath": "/healthz",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
