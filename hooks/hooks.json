{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CLAUDE_ENV_FILE\" ] && { echo \"export PATH='${CLAUDE_PLUGIN_ROOT}/bin':\\\"\\$PATH\\\"\"; echo \"export MM_ROOT='${CLAUDE_PLUGIN_ROOT}'\"; } >> \"$CLAUDE_ENV_FILE\"; exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/mm\" live hook; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/mm\" live hook; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/mm\" live hook; exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
